{
  "name": "scryboard-agent-runner",
  "version": "0.1.4-proof-of-concept",
  "private": true,
  "description": "Desktop app that runs Node-CLI Scryboard apps without a terminal. This is a proof-of-concept build: proves the click-a-link-to-download-and-run loop works, before the real tray app, auto-updates, code signing, or multi-app management get built on top of it. 0.1.4 fixes Open Folder (added in 0.1.3) to actually land inside an app's output/ folder instead of just highlighting it in the parent -- shell.openPath doesn't reliably navigate into a folder on Windows when Explorer already has a nearby window open, so this launches explorer.exe directly instead.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:icons": "electron scripts/build-icons.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "date-fns": "^3.6.0",
    "fflate": "^0.8.2",
    "jimp": "^1.6.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.scryboard.agentrunner",
    "productName": "Scryboard App Runner",
    "afterPack": "scripts/after-pack.js",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "agent-runner.js",
      "scryboard-client.js",
      "store.js",
      "index.html",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Scryboard App Install",
        "schemes": [
          "scryboard-agent"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "artifactName": "Scryboard-App-Runner-Setup.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
